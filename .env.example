# Server Configuration
PORT=5000
NODE_ENV=development

# Initial Administrator Credentials (Configured securely via Environment)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Authentication JWT Secret (Must be a long random string in production)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY
JWT_EXPIRES_IN=8h

# MongoDB Cloud Connection (Optional - system falls back to offline JSON if invalid/unreachable)
MONGODB_URI=mongodb+srv://admin:password@cluster.mongodb.net/pharmacy_db?retryWrites=true&w=majority

# Firebase Cloud Messaging (FCM) Configuration (Optional - messaging falls back silently if missing)
FIREBASE_PROJECT_ID=pharmacy-app-1234
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@pharmacy-app-1234.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Frontend Client API Base URL
VITE_API_BASE_URL=http://localhost:5000/api
